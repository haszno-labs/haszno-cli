{
  "name": "@haszno/cli",
  "version": "0.1.0",
  "description": "Haszno CLI — query and act on your dropshipping data from the terminal",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "haszno": "./dist/index.js"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsup": "^8.3.0",
    "typescript": "^5.5.4",
    "vitest": "^2.1.4"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/haszno-labs/haszno-cli.git"
  },
  "publishConfig": {
    "access": "public"
  }
}
